# mkdocs による動的発行の設定テンプレート。
#
# bin/vendor_assets.py がこのファイルを pages/livedocs/mkdocs.yml へ展開します。
# 展開時に置き換わる差し込み位置は、行全体が置換記号だけの行です。
# site_name はワークスペース側の .vscode/pub_markdown.config.yaml の
# siteName から与えます。未指定の場合はワークスペース フォルダー名を使います。
# plugins の 1 行は publocal.yaml から .nav.yml を生成した場合にだけ
# awesome-nav プラグインの行になります。
#
# 設計は framework/docsfw/docs/livedocs-design.md を参照してください。

site_name: @LIVEDOCS_SITE_NAME@ (@LIVEDOCS_VARIANT@)
site_description: docsfw の発行対象を mkdocs で動的発行します
docs_dir: src
site_dir: site
use_directory_urls: true

# ソースを直接編集するため、リンク切れは strict ビルドで検出する。
validation:
  links:
    absolute_links: ignore
    unrecognized_links: warn
  nav:
    omitted_files: ignore

theme:
  name: material
  custom_dir: theme
  language: @LIVEDOCS_THEME_LANGUAGE@
  # 本文と等幅のフォントは assets/docsfw-pandoc-style.css が
  # --md-text-font-family と --md-code-font-family で与えるため、
  # Material 既定の Google Fonts (Roboto / Roboto Mono) は取得しない。
  font: false
  features:
    - navigation.indexes
    - navigation.top
    - navigation.tracking
    - toc.follow
    - content.code.copy
    - search.suggest
    - search.highlight
  palette:
    - media: "(prefers-color-scheme: light)"
      scheme: default
      toggle:
        icon: material/weather-night
        name: ダーク モードへ切り替え
    - media: "(prefers-color-scheme: dark)"
      scheme: slate
      toggle:
        icon: material/weather-sunny
        name: ライト モードへ切り替え

markdown_extensions:
  - tables
  - footnotes
  - attr_list
  - md_in_html
  - nl2br
  - admonition
  # GitHub アラート記法 (> [!NOTE] など) を admonition へ変換する。
  - github-callouts
  - toc:
      permalink: true
      toc_depth: 3
      # 見出しの id を GitHub と同じ規則にする。
      # Python-Markdown の既定は非 ASCII を落とすため、日本語見出しへのリンクが切れる。
      slugify: !!python/object/apply:pymdownx.slugs.slugify {kwds: {case: lower}}
  - pymdownx.superfences:
      custom_fences:
        - name: plantuml
          class: docsfw-plantuml
          format: !!python/name:pymdownx.superfences.fence_div_format
        - name: mermaid
          class: docsfw-mermaid
          format: !!python/name:pymdownx.superfences.fence_div_format
  - pymdownx.tasklist:
      custom_checkbox: true
  - pymdownx.mark
  - pymdownx.arithmatex:
      generic: true

plugins:
  # 日本語検索の緩和策。
  # mkdocs-material の `lang: ja` は lunr-languages 経由で TinySegmenter を
  # 使うが、TinySegmenter には複合語の分割漏れという upstream の既知バグが
  # あり (searchable な語が見つからないことがある)、mkdocs-material 側では
  # 修正できない。
  # 対策として `lang: ja` をやめ、隣接する CJK 文字 (ひらがな/カタカナ/漢字)
  # の間に separator の境界を追加し、文字単位に近い粒度で索引と検索クエリの
  # 双方を分割する。再現率を優先し、ノイズ (無関係な部分一致) の増加は許容
  # する。詳細は docs/livedocs-design.md の「全文検索について補足」を
  # 参照。
  # upstream で TinySegmenter の分割漏れが修正された場合は、この緩和策を
  # 見直すこと。
  # see: https://github.com/squidfunk/mkdocs-material/discussions/3916
  - search:
      lang: en
      separator: '[\s\-,:!=\[\]()"/]+|(?![^\d])(?=[A-Z][a-z])|(?<=[0-9])(?=[^0-9])|(?<!\d)(?=\d)|(?<=[぀-ヿ㐀-䶿一-鿿豈-﫿])(?=[぀-ヿ㐀-䶿一-鿿豈-﫿])'
@AWESOME_NAV@

extra:
  livedocs_variant: "@LIVEDOCS_VARIANT@"

extra_css:
  - assets/docsfw-livedocs.css
  - assets/docsfw-pandoc-style.css
  - assets/docsfw-doxygen-link.css

extra_javascript:
  # viz-global.js は plantuml.js より先に、通常のスクリプトとして読み込む。
  - assets/plantuml/viz-global.js
  - path: assets/docsfw-plantuml.js
    type: module
  - assets/mermaid/mermaid.min.js
  - assets/docsfw-mermaid.js
  - assets/docsfw-mathjax.js
  - assets/docsfw-responsive-nav.js
  - assets/docsfw-svg-download.js
  # MathJax は docsfw の pandoc --mathjax と同じく CDN から読み込む。
  - https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js

# Doxygen HTML の静的サーブと単一ページ リンクを先に登録する。
# 元の Markdown の変更を検知し、1 ファイル単位の軽量なステージングを
# 自動で行う。ステージング結果は docs_dir に書き込まれるため、mkdocs 標準の
# docs_dir 監視がそれを検知してビルドとブラウザーの自動リロードを行う。
# 詳細は docs/livedocs-design.md を参照。
hooks:
  - ../../framework/docsfw/livedocs/bin/livedocs_doxygen_hook.py
  - ../../framework/docsfw/livedocs/bin/livedocs_versioned_hook.py
  - ../../framework/docsfw/livedocs/bin/livedocs_autostage_hook.py
